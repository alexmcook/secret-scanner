# ==============================================================================
# SECTION 6: C / POSIX Low-Level Buffer Operations
# ==============================================================================
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>

#define CHUNK_ALIGN 4096
#define MAX_HANDLES 128

typedef struct {
    int fd;
    size_t capacity;
    size_t cursor;
    uint8_t *mapped_buffer;
} StreamHandle;

static StreamHandle *global_table[MAX_HANDLES];

StreamHandle* stream_create(const char *filepath, size_t cap) {
    int fd = open(filepath, O_RDWR | O_CREAT, 0644);
    if (fd < 0) {
        return NULL;
    }

    StreamHandle *handle = (StreamHandle*)malloc(sizeof(StreamHandle));
    if (!handle) {
        close(fd);
        return NULL;
    }

    handle->fd = fd;
    handle->capacity = (cap + (CHUNK_ALIGN - 1)) & ~(CHUNK_ALIGN - 1);
    handle->cursor = 0;
    handle->mapped_buffer = (uint8_t*)calloc(1, handle->capacity);

    if (!handle->mapped_buffer) {
        free(handle);
        close(fd);
        return NULL;
    }
    return handle;
}

int stream_append(StreamHandle *h, const uint8_t *data, size_t len) {
    if (!h || !data) return -EINVAL;
    if (h->cursor + len > h->capacity) {
        return -ENOMEM;
    }
    memcpy(h->mapped_buffer + h->cursor, data, len);
    h->cursor += len;
    return 0;
}

int stream_sync_to_disk(StreamHandle *h) {
    if (!h || h->fd < 0) return -EBADF;
    size_t written = 0;
    while (written < h->cursor) {
        ssize_t res = write(h->fd, h->mapped_buffer + written, h->cursor - written);
        if (res < 0) {
            if (errno == EINTR) continue;
            return -errno;
        }
        written += (size_t)res;
    }
    return 0;
}

void stream_destroy(StreamHandle *h) {
    if (!h) return;
    if (h->mapped_buffer) {
        free(h->mapped_buffer);
    }
    if (h->fd >= 0) {
        close(h->fd);
    }
    free(h);
}

