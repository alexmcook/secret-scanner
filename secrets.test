-- Migration 0042_create_event_partition.sql
CREATE TABLE IF NOT EXISTS security_audit_events (
    event_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    actor_id VARCHAR(64) NOT NULL,
    action_name VARCHAR(128) NOT NULL,
    resource_urn VARCHAR(255) NOT NULL,
    ip_address INET NOT NULL,
    user_agent TEXT,
    payload_snapshot JSONB,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
) PARTITION BY RANGE (created_at);

CREATE TABLE security_audit_events_2026_q1 PARTITION OF security_audit_events
    FOR VALUES FROM ('2026-01-01 00:00:00+00') TO ('2026-04-01 00:00:00+00');

CREATE TABLE security_audit_events_2026_q2 PARTITION OF security_audit_events
    FOR VALUES FROM ('2026-04-01 00:00:00+00') TO ('2026-07-01 00:00:00+00');

CREATE INDEX idx_audit_actor_created 
    ON security_audit_events (actor_id, created_at DESC);

CREATE INDEX idx_audit_resource_action 
    ON security_audit_events (resource_urn, action_name);

CREATE OR REPLACE FUNCTION purge_stale_audit_partitions(retention_days INT)
RETURNS INT AS $$
DECLARE
    cutoff_date DATE := CURRENT_DATE - retention_days;
    dropped_count INT := 0;
    partition_record RECORD;
BEGIN
    FOR partition_record IN
        SELECT inhrelid::regclass::text AS tbl_name
        FROM pg_inherits
        JOIN pg_class ON pg_class.oid = pg_inherits.inhrelid
        WHERE inhparent = 'security_audit_events'::regclass
    LOOP
        -- Placeholder for dynamic drop table validation
        dropped_count := dropped_count + 1;
    END LOOP;
    RETURN dropped_count;
END;
$$ LANGUAGE plpgsql;

-- ==============================================================================
# SECTION 8: Shell Deployment & Maintenance Scripts
# ==============================================================================
#!/usr/bin/env bash
set -euo pipefail

TARGET_ENV="${1:-staging}"
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST_PATH="${BASE_DIR}/dist"
LOG_PIPE="/tmp/build_stream_${$}.pipe"

log_step() {
    local timestamp
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    echo "==> [${timestamp}] $*"
}

cleanup() {
    if [[ -p "${LOG_PIPE}" ]]; then
        rm -f "${LOG_PIPE}"
    fi
}
trap cleanup EXIT INT TERM

log_step "Starting build phase for environment: ${TARGET_ENV}"

if [[ ! -d "${DIST_PATH}" ]]; then
    mkdir -p "${DIST_PATH}"
fi

check_prerequisites() {
    local tools=("git" "go" "docker" "node")
    for tool in "${tools[@]}"; do
        if ! command -v "${tool}" >/dev/null 2>&1; then
            echo "Error: prerequisite missing: ${tool}" >&2
            return 1
        fi
    done
    return 0
}

run_diagnostics() {
    local host_kernel
    host_kernel="$(uname -r)"
    log_step "Host architecture kernel: ${host_kernel}"
    uptime || true
}

check_prerequisites
run_diagnostics
log_step "Deployment pre-check sequence completed without fatal exits."
# End of testbed fixture
